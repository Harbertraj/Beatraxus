<?xml version="1.0" encoding="utf-8"?>
<!-- Beatraxus app-icon logo for the system splash. 288dp canvas (Android 12+ shows the central
     192dp circle); the logo is 120dp and centred, identical in size to AppOpenScreen so the
     hand-off from the system splash to the animated screen has no jump. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/beatraxus_logo" />
    </item>
</layer-list>
