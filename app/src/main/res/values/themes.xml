<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Beatraxus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.Beatraxus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Beatraxus</item>
    </style>

    <style name="Theme.CastExpandedController" parent="Theme.AppCompat.NoActionBar">
        <item name="castExpandedControllerStyle">@style/CustomCastExpandedControllerStyle</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="CustomCastExpandedControllerStyle" parent="CastExpandedController">
        <item name="castButtonColor">#FFFFFF</item>
        <item name="castPlayButtonDrawable">@drawable/ic_play</item>
        <item name="castPauseButtonDrawable">@drawable/ic_pause</item>
        <item name="castSkipNextButtonDrawable">@drawable/ic_skip_next</item>
        <item name="castSkipPreviousButtonDrawable">@drawable/ic_skip_previous</item>
        <item name="castSeekBarProgressAndThumbColor">#2196F3</item>
    </style>
</resources>
