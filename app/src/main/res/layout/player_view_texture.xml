<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView that renders the video on a TextureView.
  Used while Colour Grading is active: a TextureView is a normal hardware layer, so a
  ColorMatrix filter (brightness / contrast / saturation) can be applied to it instantly,
  also while the video is paused. A SurfaceView cannot be colour-filtered.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
